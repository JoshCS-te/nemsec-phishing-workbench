# Merge into CAPEv2 conf/api.conf. Sections not listed keep CAPE's defaults.
[api]
token_auth_enabled = yes

[filecreate]
enabled = yes
[taskstatus]
enabled = yes
[taskreport]
enabled = yes
[taskscreenshot]
enabled = yes
[machineview]
enabled = yes
[cuckoostatus]
enabled = yes
[taskdelete]
enabled = yes
[user_stop]
enabled = yes
