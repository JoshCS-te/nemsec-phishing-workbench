# Copy to .env (or set in your shell / scripts\start.ps1). All variables are optional.

# Where evidence, the SQLite database, artifacts and PDFs live
PHB_DATA_DIR=./data

# Keep the API on loopback. Changing this exposes evidence to your network.
PHB_HOST=127.0.0.1
PHB_PORT=8000
PHB_FRONTEND_ORIGIN=http://localhost:3000

# Evidence limits
PHB_MAX_UPLOAD_BYTES=26214400
PHB_MAX_ATTACHMENT_BYTES=20971520

# Static analysis worker limits
PHB_STATIC_TIMEOUT_S=20
PHB_STATIC_MEMORY_MB=512
PHB_ARCHIVE_MAX_DEPTH=3
PHB_ARCHIVE_MAX_ENTRIES=500
PHB_ARCHIVE_MAX_TOTAL_BYTES=104857600
PHB_ARCHIVE_MAX_RATIO=100

# Sandbox: disabled | demo | cape
PHB_SANDBOX_MODE=disabled
PHB_CAPE_URL=http://192.168.56.10:8000
PHB_CAPE_TOKEN=
PHB_CAPE_MACHINE=win10
PHB_CAPE_SNAPSHOT=clean
PHB_CAPE_TIMEOUT_S=120
PHB_CAPE_JOB_DEADLINE_S=900
PHB_CAPE_RESET_GRACE_S=180

# 1 = run the job worker inside the API process (convenient for demos). Default: run app.worker separately.
PHB_INLINE_WORKER=0
